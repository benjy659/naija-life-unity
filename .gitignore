# Unity .gitignore — Naija Life (Unity rebuild)
# Based on the standard Unity gitignore (github.com/github/gitignore, Unity.gitignore)

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive
[Mm]emoryCaptures/

# Recordings can get excessive
[Rr]ecordings/

# Asset Store download directory
/Assets/AssetStoreTools*

# Autogenerated VS/MD solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables build output (regenerated by build)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/

# OS artefacts
.DS_Store
Thumbs.db
Desktop.ini

# Local Unity license activation material (machine-specific, never commit)
.unity-license/
