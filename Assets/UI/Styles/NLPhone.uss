/*
 * Naija Streets — phone styles (UI Toolkit).
 * Spec: docs/specs/hud-and-phone.md §8. Tokens live in NLTokens.uss.
 * Portrait: full screen, slides up. Landscape/desktop: a 390x780 panel on
 * the right third, street visible on the left. Scrim only on portrait.
 */

.nl-phone-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }
.nl-phone { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.nl-phone-scrim {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--nl-scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.36s;
}
.nl-phone-panel {
    position: absolute;
    background-color: #05070C;
    flex-direction: column;
    opacity: 0;
    translate: 0 96px;
    scale: 0.96 0.96;
    transition-property: opacity, translate, scale;
    transition-duration: 0.36s;
    transition-timing-function: ease-out-cubic;
}
.nl-phone--open .nl-phone-scrim { opacity: 1; }
.nl-phone--open .nl-phone-panel { opacity: 1; translate: 0 0; scale: 1 1; }

/* portrait: full screen */
.nl-portrait .nl-phone-panel { left: 0; top: 0; right: 0; bottom: 0; }
/* landscape + desktop: phone-shaped panel on the right third */
.nl-landscape .nl-phone-panel,
.nl-desktop .nl-phone-panel {
    right: 24px; top: 24px; bottom: 24px;
    width: 390px;
    border-radius: 28px;
    border-width: 1px;
    border-color: var(--nl-panel-edge);
}
.nl-landscape .nl-phone-scrim,
.nl-desktop .nl-phone-scrim { display: none; }

/* status bar */
.nl-phone-status {
    height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    flex-shrink: 0;
}
.nl-phone-status .nl-icon { -unity-background-image-tint-color: var(--nl-text); width: 18px; height: 18px; }

/* nav bar (back / title / close) — hidden on home */
.nl-phone-nav {
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    flex-shrink: 0;
}
.nl-phone-back, .nl-phone-close {
    width: 44px; height: 44px;
    min-width: 44px; min-height: 44px;
    padding: 0;
    align-items: center; justify-content: center;
}
.nl-phone-back .nl-icon { -unity-background-image-tint-color: var(--nl-text); transform: rotate(90deg); }

/* screens */
.nl-phone-screen { flex-grow: 1; flex-direction: column; overflow: hidden; }
.nl-phone-page { flex-grow: 1; flex-direction: column; padding: 0 16px 16px 16px; }

/* home */
.nl-phone-home-head { flex-direction: row; align-items: center; margin-top: 8px; }
.nl-phone-logo { width: 64px; height: 64px; border-radius: 16px; }
.nl-phone-clock-block { flex-direction: column; margin-left: 12px; }
.nl-phone-big-clock { font-size: 40px; color: var(--nl-text); }
.nl-phone-next { margin-top: 20px; flex-direction: row; align-items: center; }
.nl-phone-next-texts { flex-direction: column; margin-left: 12px; }
.nl-phone-next-texts .nl-text-value { color: var(--nl-text); }
.nl-phone-grid {
    margin-top: 24px;
    flex-direction: row;
    flex-wrap: wrap;
}
.nl-phone-app {
    width: 25%;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
}
.nl-phone-app-tile {
    width: 60px; height: 60px;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.07);
    align-items: center; justify-content: center;
    border-width: 0;
}
.nl-phone-app-tile .nl-icon { width: 28px; height: 28px; }
.nl-phone-app--active .nl-phone-app-tile { background-color: var(--nl-accent); }
.nl-phone-app--active .nl-phone-app-tile .nl-icon { -unity-background-image-tint-color: var(--nl-accent-ink); }
.nl-phone-app-label { font-size: 11px; color: var(--nl-text); margin-top: 6px; text-align: center; }

/* bank */
.nl-bank-card {
    background-color: var(--nl-accent-deep);
    border-radius: var(--nl-radius-panel);
    padding: 16px;
    flex-direction: column;
}
.nl-bank-card .nl-text-kicker { color: rgba(255, 255, 255, 0.75); }
.nl-bank-balance { font-size: 38px; color: #FFFFFF; margin-top: 4px; }
.nl-bank-sync-row { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 12px; }
.nl-bank-sync-row .nl-text-body { color: rgba(255, 255, 255, 0.8); }
.nl-bank-refresh { flex-direction: row; align-items: center; }
.nl-bank-refresh .nl-icon { width: 18px; height: 18px; -unity-background-image-tint-color: #FFFFFF; }
.nl-bank-refresh .nl-text-body { color: #FFFFFF; margin-left: 6px; }
.nl-bank-tabs {
    flex-direction: row;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: var(--nl-radius-card);
    padding: 4px;
    margin-top: 16px;
}
.nl-bank-tab {
    flex-grow: 1;
    height: 40px;
    border-radius: 10px;
    align-items: center; justify-content: center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.nl-bank-tab .nl-text-value { color: var(--nl-text-dim); }
.nl-bank-tab--active { background-color: var(--nl-accent); }
.nl-bank-tab--active .nl-text-value { color: var(--nl-accent-ink); }
.nl-bank-list { flex-direction: column; margin-top: 8px; }
.nl-bank-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}
.nl-bank-row-texts { flex-direction: column; flex-grow: 1; margin-left: 12px; }
.nl-bank-row-texts .nl-text-value { color: var(--nl-text); }
.nl-bank-row-texts .nl-text-body { color: var(--nl-text-dim); font-size: 12px; }
.nl-bank-amount { font-size: 16px; color: var(--nl-text); }
.nl-bank-amount--in { color: var(--nl-accent); }
.nl-bank-week-row { flex-direction: row; justify-content: space-between; padding: 12px 4px; }
.nl-bank-lock {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: var(--nl-radius-card);
    padding: 12px;
    margin-top: 16px;
}
.nl-bank-lock .nl-icon { width: 18px; height: 18px; flex-shrink: 0; }
.nl-bank-lock .nl-text-body { color: var(--nl-text-dim); margin-left: 8px; font-size: 12px; }
.nl-bank-state { align-items: center; padding: 24px 0; }
.nl-bank-state .nl-text-body { color: var(--nl-text-dim); text-align: center; }

/* map stub */
.nl-map-stub { flex-grow: 1; flex-direction: column; align-items: center; justify-content: center; }
.nl-map-stub .nl-radar-wrap { width: 200px; height: 200px; }
.nl-map-stub .nl-text-title { margin-top: 16px; }
.nl-map-stub .nl-text-body { color: var(--nl-text-dim); text-align: center; margin-top: 8px; }

/* settings */
.nl-settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    padding: 8px 0;
}
.nl-settings-texts { flex-direction: column; flex-grow: 1; }
.nl-settings-texts .nl-text-body { color: var(--nl-text-dim); font-size: 12px; }
.nl-settings-toggle {
    width: 52px; height: 32px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.16);
    border-width: 0;
    padding: 0;
}
.nl-settings-toggle--on { background-color: var(--nl-accent); }
